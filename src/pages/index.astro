---
import Layout from '../layouts/Layout.astro';

const TEMPLATE_REPO = 'https://github.com/petytor/jawna-sprawa';
const GENERATE_URL = `${TEMPLATE_REPO}/generate`;

const setup = [
  {
    number: '01',
    title: 'Utwórz własną kopię',
    description: 'Na stronie szablonu wybierz „Use this template” → „Create a new repository”. Nadaj kopii nazwę. Potrzebujesz bezpłatnego konta GitHub.',
    note: 'Twoje konto GitHub',
  },
  {
    number: '02',
    title: 'Włącz stronę w GitHubie',
    description: 'W ustawieniach kopii wybierz Pages, a potem GitHub Actions. GitHub sam opublikuje stronę pod własnym adresem.',
    note: 'Bez dodatkowej usługi',
  },
  {
    number: '03',
    title: 'Włącz panel edycji',
    description: 'Utwórz bezpłatną stronę w Decap Turbo, połącz ją z kopią w GitHubie i wklej jej identyfikator do ustawień. Potem dodawaj wpisy w formularzu.',
    note: 'Dla jednej osoby i jednej strony',
  },
];

const features = [
  {
    number: '01',
    title: 'Pisma i odpowiedzi',
    description: 'Udostępnij wysłany wniosek, odpowiedź urzędu i krótki opis sprawy w jednym miejscu.',
    icon: 'document',
  },
  {
    number: '02',
    title: 'Kolejne działania',
    description: 'Pokaż kiedy wysłałeś wniosek, kiedy przyszła odpowiedź i co zrobiłeś dalej.',
    icon: 'timeline',
  },
  {
    number: '03',
    title: 'Czytelny przebieg spraw',
    description: 'Mieszkańcy szybko sprawdzą, czym się zajmujesz i co odpowiedział urząd.',
    icon: 'overview',
  },
  {
    number: '04',
    title: 'Ostrzeżenie przed danymi osobowymi',
    description: 'Panel podpowie, co warto zamazać. Zawsze sam sprawdź dokumenty przed publikacją.',
    icon: 'privacy',
  },
];
---

<Layout
  title="petytor — pokaż, o co pytasz i co odpowiada urząd"
  description="Dla osób składających wnioski do urzędów, aktywistów, radnych i mieszkańców, którzy chcą pokazać swoje działania, pisma i odpowiedzi władz."
>
  <div class="site-shell">
    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="petytor — strona główna">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 44 44" fill="none">
            <path d="M8 5.5h19l9 9V38.5H8z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
            <path d="M27 5.5v9h9M14 22h16M14 28h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
            <circle cx="29.5" cy="31.5" r="5.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.4" />
            <path d="m27.7 31.5 1.2 1.2 2.5-2.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="brand-name">petytor<span class="brand-period">.</span><small>JAWNOŚĆ W PRAKTYCE</small></span>
      </a>
      <nav class="header-nav" aria-label="Nawigacja główna">
        <a href="#jak-zaczac">Jak zacząć</a>
        <a href="#dla-kogo">Dla kogo</a>
        <a class="nav-cta" href={TEMPLATE_REPO} target="_blank" rel="noreferrer">Zobacz projekt <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> DLA OSÓB, KTÓRE DZIAŁAJĄ DLA MIESZKAŃCÓW</p>
          <h1 id="hero-title">Pokaż, o co pytasz.<br /><span>Co odpowiada urząd.</span></h1>
          <p class="hero-lede"><strong>jawna-sprawa</strong> jest dla osób składających wnioski do urzędów, aktywistów, radnych i innych mieszkańców, którzy chcą pokazać swoją pracę. Zbieraj pisma, urzędowe odpowiedzi i dalsze działania w jednym miejscu — żeby każdy mógł sam ocenić, jak władza traktuje obywateli.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={GENERATE_URL} target="_blank" rel="noreferrer">
              Utwórz stronę bez opłat <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#jak-zaczac">Zobacz, jak to działa <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-meta" aria-label="Wymagania">
            <span><span class="check-mark">✓</span> 0 zł za korzystanie</span>
            <span><span class="check-mark">✓</span> Bez płatnego hostingu</span>
            <span><span class="check-mark">✓</span> Wpisy przez formularz</span>
          </div>
          <p class="hero-privacy"><span aria-hidden="true">!</span> Repozytorium i strona są publiczne. <a href="#prywatnosc">Publikuj tylko zanonimizowane materiały.</a></p>
        </div>

        <div class="hero-art" aria-label="Podgląd przykładowej publicznej osi czasu sprawy">
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="paper-card">
            <div class="paper-topline"><span class="paper-tag"><i></i> SPRAWA PUBLICZNA</span><span class="paper-menu" aria-hidden="true">•••</span></div>
            <p class="paper-kicker">WNIOSEK O INFORMACJĘ PUBLICZNĄ</p>
            <h2>Modernizacja<br />ul. Ogrodowej</h2>
            <div class="paper-stats">
              <div><strong>4</strong><span>zdarzenia</span></div>
              <div><strong>21 <small>dni</small></strong><span>od złożenia</span></div>
            </div>
            <div class="mini-timeline">
              <div class="timeline-entry done"><span class="timeline-node"></span><div><strong>Wniosek złożony</strong><small>12 czerwca · pismo dodane</small></div><b>✓</b></div>
              <div class="timeline-entry waiting"><span class="timeline-node"></span><div><strong>Oczekiwanie na odpowiedź</strong><small>Termin upływa za 3 dni</small></div><b>3d</b></div>
              <div class="timeline-entry next"><span class="timeline-node"></span><div><strong>Kolejny krok</strong><small>Dodasz go po aktualizacji</small></div></div>
            </div>
            <div class="paper-foot"><span class="paper-lock">↗</span> Dokumenty i postęp w jednym miejscu</div>
          </div>
          <div class="art-stamp"><span>JAWNIE<br />OD PIERWSZEGO<br />DNIA</span><svg viewBox="0 0 60 60" aria-hidden="true"><path d="M12 30h36M30 12v36" /></svg></div>
          <div class="art-caption"><span class="caption-line"></span> PRZYKŁADOWY WIDOK SPRAWY</div>
        </div>
      </section>

      <section class="trust-strip" aria-label="Cechy projektu">
        <div class="wrap trust-inner">
          <p>STWORZONE Z MYŚLĄ O <strong>JAWNOŚCI</strong></p>
          <span class="trust-divider"></span>
          <span><i>↗</i> Bez opłat za hosting</span>
          <span><i>⌁</i> Bez własnego serwera</span>
          <span><i>◎</i> Twoja strona i treść</span>
        </div>
      </section>

      <section class="features-section wrap" id="dla-kogo">
        <div class="section-intro">
          <div><p class="eyebrow">CO POKAŻESZ</p><h2>Pisma, odpowiedzi<br /><span>i Twoje działania.</span></h2></div>
          <p>Jedno miejsce pozwala mieszkańcom zobaczyć, o co pytasz, co odpowiedział urząd i co robisz dalej.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <div class="feature-card-top"><span class="feature-number">{feature.number}</span>
                <span class="feature-icon" aria-hidden="true">
                  {feature.icon === 'document' && <svg viewBox="0 0 32 32"><path d="M8 4h11l6 6v18H8zM19 4v7h6M12 16h9M12 21h9" /></svg>}
                  {feature.icon === 'timeline' && <svg viewBox="0 0 32 32"><path d="M9 6v20M9 9h14M9 17h11M9 25h14" /><circle cx="9" cy="9" r="2" /><circle cx="9" cy="17" r="2" /><circle cx="9" cy="25" r="2" /></svg>}
                  {feature.icon === 'overview' && <svg viewBox="0 0 32 32"><path d="M5 26h22M8 22V13h5v9M17 22V7h5v15" /></svg>}
                  {feature.icon === 'privacy' && <svg viewBox="0 0 32 32"><path d="M16 4 26 8v7c0 6-4.2 10.5-10 13-5.8-2.5-10-7-10-13V8zM11.5 16l3 3 6-6" /></svg>}
                </span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
        <aside class="cost-note">
          <span class="cost-amount">0 zł</span>
          <p><strong>Nie potrzebujesz płatnego hostingu, serwera ani własnej domeny.</strong> Dla jednej osoby prowadzącej jedną stronę wystarczą bezpłatne plany GitHub Pages i Decap Turbo. Nie planuję pobierać opłat za szablon ani korzystanie z niego. Zewnętrzne usługi mogą w przyszłości zmienić swoje zasady.</p>
        </aside>
        <aside class="privacy-note" id="prywatnosc"><span class="privacy-icon" aria-hidden="true">!</span><p><strong>Jawność wymaga namysłu.</strong> Publiczna strona i repozytorium mogą ujawnić więcej, niż planujesz — również w historii zmian. Przed publikacją usuń dane osobowe z treści i skanów.</p><a href={`${TEMPLATE_REPO}#anonimizacja`} target="_blank" rel="noreferrer">Jak anonimizować <span aria-hidden="true">↗</span></a></aside>
      </section>

      <section class="why-section wrap" id="dlaczego">
        <div class="why-mark" aria-hidden="true">„</div>
        <div class="why-copy">
          <p class="eyebrow">DLACZEGO TO STWORZYŁEM</p>
          <h2>Niech ludzie sami ocenią, jak władza odpowiada obywatelom.</h2>
          <p>Chciałem w przejrzysty sposób dzielić się odpowiedziami, które dostaję z urzędów — tak, żeby każdy mógł sam ocenić podejście władzy do obywatela. Ten szablon pomaga mi i innym pokazać całą sprawę: od wysłanego pisma, przez odpowiedź, po dalsze działania.</p>
          <a href="https://suppi.pl/mleczakm" target="_blank" rel="noreferrer">Jeśli Ci się przyda, możesz postawić mi kawę <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="setup-section" id="jak-zaczac">
        <div class="wrap setup-wrap">
          <div class="setup-heading"><div><p class="eyebrow">PIERWSZE KROKI</p><h2>Od kopii szablonu<br /><span>do Twojej strony.</span></h2></div><p>Nie instalujesz programu ani serwera. Wystarczy bezpłatne konto GitHub; panel edycji uruchomisz bezpłatnie w Decap Turbo.</p></div>
          <ol class="setup-grid">
            {setup.map((step) => (
            <li class="setup-step"><span class="step-number">{step.number}</span><div class="step-line"></div><h3>{step.title}</h3><p>{step.number === '03' ? <>Załóż konto w <a href="https://decapcms.org/turbo/" target="_blank" rel="noreferrer">Decap Turbo</a>, połącz kopię i wykonaj krótką konfigurację opisaną w instrukcji. Potem dodawaj pisma i odpowiedzi przez formularz.</> : step.description}</p><span class="step-note">{step.note}</span></li>
            ))}
          </ol>
          <div class="setup-bottom"><p>GitHub Pages opublikuje stronę automatycznie po włączeniu tej opcji. Instrukcja pokazuje dokładnie, gdzie kliknąć i jak połączyć panel edycji.</p><a class="button button-light" href={TEMPLATE_REPO} target="_blank" rel="noreferrer">Instrukcja krok po kroku <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="final-cta wrap">
        <div class="cta-mark" aria-hidden="true"><svg viewBox="0 0 44 44" fill="none"><path d="M8 5.5h19l9 9V38.5H8z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" /><path d="M27 5.5v9h9M14 22h16M14 28h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /><circle cx="29.5" cy="31.5" r="5.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.4" /><path d="m27.7 31.5 1.2 1.2 2.5-2.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
        <div><p class="eyebrow">BEZ OPŁAT ZA SZABLON</p><h2>Pokaż swoją pracę mieszkańcom.</h2></div>
        <a class="button button-primary" href={GENERATE_URL} target="_blank" rel="noreferrer">Utwórz swoją stronę <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer"><div class="wrap footer-inner"><a class="footer-brand" href="#top">petytor<span>.</span></a><p>Otwarty projekt na rzecz jawności spraw publicznych.</p><a href="https://suppi.pl/mleczakm" target="_blank" rel="noreferrer">Postaw mi kawę ↗</a></div></footer>
  </div>
</Layout>
